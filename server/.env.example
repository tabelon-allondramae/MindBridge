# Database (get this from Supabase/Railway/Neon after creating a Postgres instance)
DATABASE_URL="postgresql://user:password@localhost:5432/mindbridge"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Journal/chat field-level encryption (32-byte key, hex-encoded = 64 chars)
FIELD_ENCRYPTION_KEY=replace_with_64_hex_characters

# AI provider
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
AI_MODEL=claude-sonnet-4-6
